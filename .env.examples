# Copy to .env only if you do not already have one. Keep .env private.
# Replace paths/identifiers, then run: python3 -m media_archive --check-config
# Values are literal; no ~, $HOME, interpolation or shell execution.
# This is configuration only. IMPORT/SORT/BACKUP/AUDIT are not implemented yet.
APP_TIMEZONE='Europe/Warsaw'
APP_CONFIG_FILE='.env'
APP_DATABASE_FILE='/home/your-user/.local/state/media-archive/state.sqlite3'
APP_REPORTS_DIR='/home/your-user/.local/state/media-archive/reports'
APP_MIN_FREE_BYTES=1073741824
APP_REPORT_KEEP_RUNS=20
APP_DATABASE_KEEP_GENERATIONS=5
APP_ARCHIVE_STATE_DIR='.media-archive'

LOCAL_VOLUMES='working'
LOCAL_VOLUME_WORKING_ROOT='/path/to/working-volume'
LOCAL_VOLUME_WORKING_UUID='REPLACE_WITH_WORKING_VOLUME_UUID'
# Keep both outside every collection included in a full backup.
LOCAL_STAGING_ROOT='/path/to/working-volume/.media-archive-staging'
LOCAL_UNDATED_ROOT='/path/to/working-volume/Unresolved'

# Reusable policies; names do not carry behavior.
# changes: keep_both (hash-suffix conflicts) | replace_verified
# deletions: keep | confirm_each_run (exact list approval is always required)
POLICIES='append,documents,selection,backlog'
POLICY_APPEND_CHANGES='keep_both'
POLICY_APPEND_DELETIONS='keep'
POLICY_DOCUMENTS_CHANGES='replace_verified'
POLICY_DOCUMENTS_DELETIONS='keep'
POLICY_SELECTION_CHANGES='replace_verified'
POLICY_SELECTION_DELETIONS='confirm_each_run'
POLICY_BACKLOG_CHANGES='keep_both'
POLICY_BACKLOG_DELETIONS='confirm_each_run'

# Each local root is defined once. IDs are stable, case-insensitive registry
# names (letters, digits, underscores; first character must be a letter).
# Default IDs match the legacy adapter. When converting an existing setup,
# preserve its collection IDs and source aliases, including custom entries.
# A child explicitly names its nearest parent and overrides its policy.
# Its archive path must preserve the same relative suffix as its local path.
COLLECTIONS='photos,photos_main,photos_secondary,review,reviewed,sent,backlog,printed,documents,gopro'
COLLECTION_PHOTOS_LABEL='Photos'
COLLECTION_PHOTOS_LOCAL_ROOT='/path/to/working-volume/Photos'
COLLECTION_PHOTOS_ARCHIVE_RELATIVE='Photos'
COLLECTION_PHOTOS_POLICY='append'

COLLECTION_PHOTOS_MAIN_LABEL='Main phone'
COLLECTION_PHOTOS_MAIN_LOCAL_ROOT='/path/to/working-volume/Photos/All/Main'
COLLECTION_PHOTOS_MAIN_ARCHIVE_RELATIVE='Photos/All/Main'
COLLECTION_PHOTOS_MAIN_POLICY='append'
COLLECTION_PHOTOS_MAIN_PARENT='photos'
COLLECTION_PHOTOS_MAIN_LAYOUT='year_month'

COLLECTION_PHOTOS_SECONDARY_LABEL='Secondary phone'
COLLECTION_PHOTOS_SECONDARY_LOCAL_ROOT='/path/to/working-volume/Photos/All/Secondary'
COLLECTION_PHOTOS_SECONDARY_ARCHIVE_RELATIVE='Photos/All/Secondary'
COLLECTION_PHOTOS_SECONDARY_POLICY='append'
COLLECTION_PHOTOS_SECONDARY_PARENT='photos'
COLLECTION_PHOTOS_SECONDARY_LAYOUT='year_month'

# Only these four explicit subtrees are eligible for confirmed deletion.
# No permission is inherited. Do not enable deletion on other collections
# without deliberately reviewing the intended policy. No deletion runs yet.
COLLECTION_REVIEW_LABEL='To review'
COLLECTION_REVIEW_LOCAL_ROOT='/path/to/working-volume/Photos/1.to-review'
COLLECTION_REVIEW_ARCHIVE_RELATIVE='Photos/1.to-review'
COLLECTION_REVIEW_POLICY='selection'
COLLECTION_REVIEW_PARENT='photos'
COLLECTION_REVIEW_ALLOW_DELETE=true
COLLECTION_REVIEWED_LABEL='Reviewed'
COLLECTION_REVIEWED_LOCAL_ROOT='/path/to/working-volume/Photos/2.reviewed'
COLLECTION_REVIEWED_ARCHIVE_RELATIVE='Photos/2.reviewed'
COLLECTION_REVIEWED_POLICY='selection'
COLLECTION_REVIEWED_PARENT='photos'
COLLECTION_REVIEWED_ALLOW_DELETE=true
COLLECTION_SENT_LABEL='Sent to print'
COLLECTION_SENT_LOCAL_ROOT='/path/to/working-volume/Photos/3.sent-to-print'
COLLECTION_SENT_ARCHIVE_RELATIVE='Photos/3.sent-to-print'
COLLECTION_SENT_POLICY='selection'
COLLECTION_SENT_PARENT='photos'
COLLECTION_SENT_ALLOW_DELETE=true
COLLECTION_BACKLOG_LABEL='Print backlog'
COLLECTION_BACKLOG_LOCAL_ROOT='/path/to/working-volume/Photos/Print backlog'
COLLECTION_BACKLOG_ARCHIVE_RELATIVE='Photos/Print backlog'
COLLECTION_BACKLOG_POLICY='backlog'
COLLECTION_BACKLOG_PARENT='photos'
COLLECTION_BACKLOG_ALLOW_DELETE=true
COLLECTION_PRINTED_LABEL='Printed'
COLLECTION_PRINTED_LOCAL_ROOT='/path/to/working-volume/Photos/Printed'
COLLECTION_PRINTED_ARCHIVE_RELATIVE='Photos/Printed'
COLLECTION_PRINTED_POLICY='append'
COLLECTION_PRINTED_PARENT='photos'

COLLECTION_DOCUMENTS_LABEL='Documents'
COLLECTION_DOCUMENTS_LOCAL_ROOT='/path/to/working-volume/Documents'
COLLECTION_DOCUMENTS_ARCHIVE_RELATIVE='Documents'
COLLECTION_DOCUMENTS_POLICY='documents'
COLLECTION_GOPRO_LABEL='Camera originals'
COLLECTION_GOPRO_LOCAL_ROOT='/path/to/working-volume/GoPro'
COLLECTION_GOPRO_ARCHIVE_RELATIVE='GoPro'
COLLECTION_GOPRO_POLICY='append'
COLLECTION_GOPRO_LAYOUT='gopro_day'

# Import profiles refer to collections by ID, never repeat their paths.
# ALIAS is persistent identity; change LABEL to rename what users see.
PHONE_PROFILES='main,secondary'
PHONE_MAIN_ALIAS='main'
PHONE_MAIN_LABEL='Main phone'
PHONE_MAIN_COLLECTION='photos_main'
PHONE_MAIN_MODEL=''
PHONE_MAIN_TRANSPORT='adb'
PHONE_MAIN_SERIAL='REPLACE_WITH_ADB_SERIAL'
PHONE_MAIN_CAMERA_DIR='/sdcard/DCIM/Camera'
# One-time choice: import_missing | baseline_skip_missing.
# After initialization both use the same incremental import history.
PHONE_MAIN_INITIAL_POLICY='import_missing'
PHONE_SECONDARY_ALIAS='secondary'
PHONE_SECONDARY_LABEL='Secondary phone'
PHONE_SECONDARY_COLLECTION='photos_secondary'
# Inactive until all three connection fields are filled.
PHONE_SECONDARY_TRANSPORT=''
PHONE_SECONDARY_SERIAL=''
PHONE_SECONDARY_CAMERA_DIR=''
PHONE_SECONDARY_INITIAL_POLICY='import_missing'

GOPRO_PROFILES='hero8'
GOPRO_CARDS='a,b'
GOPRO_CARD_A_UUID='REPLACE_WITH_CARD_A_UUID'
GOPRO_CARD_B_UUID='REPLACE_WITH_CARD_B_UUID'
# Empty UUID means unknown identity, never automatic trust after formatting.
GOPRO_HERO8_ALIAS='hero8'
GOPRO_HERO8_LABEL='Action camera'
GOPRO_HERO8_COLLECTION='gopro'
GOPRO_HERO8_MODEL='HERO8 Black'
GOPRO_HERO8_CAMERA_FOLDER='HERO8 Black 1'
GOPRO_HERO8_SOURCE_RELATIVE='DCIM'
GOPRO_HERO8_SOURCE_EXAMPLE_SUBDIR='100GOPRO'
GOPRO_HERO8_IGNORE_EXTENSIONS='THM,LRV'
GOPRO_HERO8_CARDS='a,b'

# Any number of groups and targets. Never reuse an old disk's UUID entry
# for a new disk. Keep old targets read_only and add a new active target.
# read_only excludes media writes, deletion and state snapshot writes.
ARCHIVE_GROUPS='data,video'
ARCHIVE_DATA_ROOT_RELATIVE='Data'
ARCHIVE_DATA_TARGETS='a,b'
ARCHIVE_DATA_TARGET_A_MOUNT='/path/to/data-archive-a'
ARCHIVE_DATA_TARGET_A_UUID='REPLACE_WITH_DATA_ARCHIVE_A_UUID'
ARCHIVE_DATA_TARGET_A_STATE='active'
ARCHIVE_DATA_TARGET_B_MOUNT='/path/to/data-archive-b'
ARCHIVE_DATA_TARGET_B_UUID='REPLACE_WITH_DATA_ARCHIVE_B_UUID'
ARCHIVE_DATA_TARGET_B_STATE='active'
ARCHIVE_VIDEO_ROOT_RELATIVE='Video'
ARCHIVE_VIDEO_TARGETS='a,b'
ARCHIVE_VIDEO_TARGET_A_MOUNT='/path/to/video-archive-a'
ARCHIVE_VIDEO_TARGET_A_UUID='REPLACE_WITH_VIDEO_ARCHIVE_A_UUID'
ARCHIVE_VIDEO_TARGET_A_STATE='active'
ARCHIVE_VIDEO_TARGET_B_MOUNT='/path/to/video-archive-b'
ARCHIVE_VIDEO_TARGET_B_UUID='REPLACE_WITH_VIDEO_ARCHIVE_B_UUID'
ARCHIVE_VIDEO_TARGET_B_STATE='active'

# A profile's All includes all these root collections and their children.
# Photos/All includes the complete Photos tree, including helper files.
# Photos/month combines year_month children from both phone profiles.
# gopro_day uses day directories; plain collections have no month submenu.
# Month availability will be determined against selected connected targets.
BACKUP_PROFILES='data,video'
BACKUP_DATA_LABEL='Data'
BACKUP_DATA_ARCHIVE_GROUP='data'
BACKUP_DATA_COLLECTIONS='photos,documents'
BACKUP_DATA_MONTH_FILTER='pending_selected_targets'
BACKUP_VIDEO_LABEL='Video'
BACKUP_VIDEO_ARCHIVE_GROUP='video'
BACKUP_VIDEO_COLLECTIONS='gopro'
BACKUP_VIDEO_MONTH_FILTER='pending_selected_targets'
# A FinishedVideos collection can use append + plain. Choose its group/profile
# explicitly; it is not automatically assigned to the video archives.
# Archive root + collection relative path will be locked by future SQLite
# registration. --check-config neither registers nor locks mappings.
