# Copy this file to .env and replace the example paths and device identifiers.
# Configuration loading is planned; the CLI is not implemented yet.
# Use absolute paths. Values are literal: do not rely on ~, $HOME or interpolation.
# Keep .env private. Do not execute it as a shell script.

APP_TIMEZONE='Europe/Warsaw'
APP_CONFIG_FILE='.env'
APP_DATABASE_FILE='/home/your-user/.local/state/media-archive/state.sqlite3'
APP_REPORTS_DIR='/home/your-user/.local/state/media-archive/reports'
APP_MIN_FREE_BYTES=1073741824
APP_REPORT_KEEP_RUNS=20
APP_DATABASE_KEEP_GENERATIONS=5
APP_ARCHIVE_STATE_DIR='.media-archive'

# Local working volume and collections. Replace every /path/to/... value.
LOCAL_VOLUME_ROOT='/path/to/working-volume'
LOCAL_VOLUME_UUID='REPLACE_WITH_WORKING_VOLUME_UUID'
LOCAL_PHOTOS_ROOT='/path/to/working-volume/Photos'
LOCAL_MAIN_MEDIA_ROOT='/path/to/working-volume/Photos/All'
LOCAL_SECONDARY_MEDIA_ROOT='/path/to/working-volume/Photos/All/Secondary'
LOCAL_GOPRO_ROOT='/path/to/working-volume/GoPro'
LOCAL_DOCUMENTS_ROOT='/path/to/working-volume/Documents'
# Keep staging and unresolved dates outside the collections backed up by "All".
LOCAL_STAGING_ROOT='/path/to/working-volume/.media-archive-staging'
LOCAL_UNDATED_ROOT='/path/to/working-volume/Unresolved'

# Main phone: fill in the ADB serial; descriptive fields are optional.
PHONE_MAIN_ALIAS='main'
PHONE_MAIN_MODEL=''
PHONE_MAIN_ANDROID_VERSION=''
PHONE_MAIN_BUILD=''
PHONE_MAIN_TRANSPORT='adb'
PHONE_MAIN_SERIAL='REPLACE_WITH_ADB_SERIAL'
PHONE_MAIN_CAMERA_DIR='/sdcard/DCIM/Camera'
# Normal initial import. baseline_skip_missing is only for an explicitly
# selected baseline of a previously curated phone collection, not a safe default.
PHONE_MAIN_INITIAL_POLICY='import_missing'

# Future secondary phone: leave transport/serial/source empty until configured.
PHONE_SECONDARY_ALIAS='secondary'
PHONE_SECONDARY_TRANSPORT=''
PHONE_SECONDARY_SERIAL=''
PHONE_SECONDARY_CAMERA_DIR=''
PHONE_SECONDARY_INITIAL_POLICY='import_missing'

# GoPro cards: filesystem UUIDs may change after formatting.
GOPRO_MODEL='HERO8 Black'
GOPRO_CAMERA_FOLDER='HERO8 Black 1'
GOPRO_CARD_A_UUID='REPLACE_WITH_CARD_A_UUID'
GOPRO_CARD_B_UUID='REPLACE_WITH_CARD_B_UUID'
GOPRO_SOURCE_RELATIVE='DCIM'
GOPRO_SOURCE_EXAMPLE_SUBDIR='100GOPRO'
GOPRO_IGNORE_EXTENSIONS='THM,LRV'

# Data archive pair. Relative paths are below each archive mount point.
DATA_ARCHIVE_A_MOUNT='/path/to/data-archive-a'
DATA_ARCHIVE_A_UUID='REPLACE_WITH_DATA_ARCHIVE_A_UUID'
DATA_ARCHIVE_B_MOUNT='/path/to/data-archive-b'
DATA_ARCHIVE_B_UUID='REPLACE_WITH_DATA_ARCHIVE_B_UUID'
DATA_ARCHIVE_ROOT_RELATIVE='Data'
DATA_ARCHIVE_PHOTOS_RELATIVE='Photos'
DATA_ARCHIVE_DOCUMENTS_RELATIVE='Documents'

# Video archive pair.
VIDEO_ARCHIVE_A_MOUNT='/path/to/video-archive-a'
VIDEO_ARCHIVE_A_UUID='REPLACE_WITH_VIDEO_ARCHIVE_A_UUID'
VIDEO_ARCHIVE_B_MOUNT='/path/to/video-archive-b'
VIDEO_ARCHIVE_B_UUID='REPLACE_WITH_VIDEO_ARCHIVE_B_UUID'
VIDEO_ARCHIVE_ROOT_RELATIVE='Video'
VIDEO_ARCHIVE_GOPRO_RELATIVE='GoPro'

# Photo workflow folders, relative to LOCAL_PHOTOS_ROOT.
# Match your existing folder names exactly.
PHOTO_REVIEW_RELATIVE='1.to-review'
PHOTO_REVIEWED_RELATIVE='2.reviewed'
PHOTO_SENT_TO_PRINT_RELATIVE='3.sent-to-print'
PHOTO_PRINT_BACKLOG_RELATIVE='Print backlog'
# Permanent collection: local deletions must not delete archive copies.
PHOTO_PRINTED_ARCHIVE_RELATIVE='Printed'
